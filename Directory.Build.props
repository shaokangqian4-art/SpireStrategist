<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>0.6.55</Version>
    <DefectPriorPath>$(MSBuildThisFileDirectory)data/defect-draft-v0.14.json</DefectPriorPath>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />
</Project>
